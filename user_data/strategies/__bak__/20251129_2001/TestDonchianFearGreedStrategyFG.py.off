# [FG_OVERRIDE_MONKEYPATCH_V33]
def _fg_override_populate_entry_trend_v33(self, dataframe, metadata):
    import os, numpy as np, pandas as pd
    df = dataframe.copy()
    for col in ('open','high','low','close','volume'):
        if col not in df.columns and col in dataframe.columns: df[col] = dataframe[col]

    # 1) Donchian(크로스) + Volume + Candle Quality
    dc_p = int(os.getenv('DC_P', getattr(getattr(self,'buy_dc_period',None),'value',19) or 19))
    vol_mult = float(os.getenv('VOL_MULT', getattr(getattr(self,'buy_vol_mult',None),'value',2.1) or 2.1))
    rh = df['high'].rolling(dc_p, min_periods=dc_p).max()
    dc_high      = rh.shift(1)
    dc_high_prev = rh.shift(2)
    cross_only = int(os.getenv('CROSS_ONLY','1')) == 1
    cond_now   = df['close'] > dc_high
    cond_cross = (df['close'] > dc_high) & (df['close'].shift(1) <= dc_high_prev)
    cond_dc = cond_cross if cross_only else cond_now

    vol_ma = df['volume'].rolling(20, min_periods=1).mean()
    cond_vol = df['volume'] >= (vol_ma * vol_mult)

    body_min_bp = float(os.getenv('BODY_MIN_BP','20'))   # 0.20%
    close_pos   = float(os.getenv('CLOSE_POS','0.30'))   # 고가 대비 30% 이내
    body_bp   = (df['close'] - df['open']).abs() / df['open'] * 10000.0
    near_high = (df['high'] - df['close']) <= (df['high'] - df['low']) * close_pos
    cond_quality = (body_bp >= body_min_bp) & near_high

    candidates = cond_dc & cond_vol & cond_quality

    # 2) FG 게이트
    thr = int(os.getenv('FG_THR', (self._p('fg_threshold',52) if hasattr(self,'_p') else 52)))
    fgcol = next((c for c in ('fg','fear_greed','feargreed','fg_value') if c in df.columns), None)
    if fgcol is None: df['fg_eff'] = 50.0
    else:             df['fg_eff'] = df[fgcol].ffill().fillna(50.0)
    cond_fg = (df['fg_eff'] >= thr)

    final_enter = candidates & cond_fg

    # 3) 쿨다운
    cd = int(os.getenv('COOL','8'))
    if cd > 0:
        recent = final_enter.shift(1).rolling(cd).max().fillna(False).astype(bool)
        final_enter = final_enter & (~recent)

    # 4) 결과
    df['enter_long'] = final_enter.astype('int8')
    if 'enter_tag' not in df.columns: df['enter_tag'] = ''
    df.loc[df['enter_long'] == 1, 'enter_tag'] = 'donchian&vol&fg'
    df['enter_tag'] = df['enter_tag'].astype('string')

    pair = (metadata or {}).get('pair','?')
    try:
        print("[FG][FINAL] %s cand=%d pass=%d thr=%d dc_p=%d vol_mult=%.2f cross=%d body_bp>=%.1f close_pos<=%.2f cool=%d"
              % (pair, int(candidates.sum()), int(final_enter.sum()), int(thr), int(dc_p), float(vol_mult),
                 int(cross_only), float(body_min_bp), float(close_pos), int(cd)))
    except Exception: pass
    return df

# 바인딩
try:
    _cls = TestDonchianFearGreedStrategyFG
    if not hasattr(_cls,'_orig_populate_entry_trend'):
        _cls._orig_populate_entry_trend = _cls.populate_entry_trend
    _cls.populate_entry_trend = _fg_override_populate_entry_trend_v33
except NameError: pass
