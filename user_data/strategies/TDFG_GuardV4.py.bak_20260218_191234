from __future__ import annotations

import numpy as np
import pandas as pd
import talib.abstract as ta

from TDFG_GuardV2 import TDFG_GuardV2


class TDFG_GuardV4(TDFG_GuardV2):
    """
    GuardV4 = GuardV2 랩퍼 + (포렌식과 동일한 정의로) 가드 피처를 직접 계산해서 entry를 강제 차단.
    핵심: override(JSON)의 strategy_parameters 값을 '실제로' 읽어서 적용한다.
    """

    GUARD_VOL_LOOKBACK = 48
    GUARD_RSI_PERIOD = 14

    @staticmethod
    def _get_param(obj, default=None):
        if obj is None:
            return default
        return getattr(obj, "value", obj)

    def _guard_cfg(self) -> dict:
        """
        override 예:
        {
          "strategy_parameters": {
            "TDFG_GuardV4": { "guard_close_pos_min": 0.35, ... }
          }
        }
        """
        cfg = getattr(self, "config", None)
        if not isinstance(cfg, dict):
            return {}
        sp = cfg.get("strategy_parameters") or {}
        if not isinstance(sp, dict):
            return {}
        grp = sp.get(self.__class__.__name__) or {}
        return grp if isinstance(grp, dict) else {}

    def _get_guard(self, key: str, default=None):
        grp = self._guard_cfg()
        if key in grp:
            return grp.get(key)
        # fallback: attribute / Parameter
        return self._get_param(getattr(self, key, None), default)

    def populate_indicators(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:
        df = super().populate_indicators(dataframe, metadata)

        # DC period는 buy_dc_period가 있으면 그걸 쓰고, 없으면 20
        dc_p = 20
        if hasattr(self, "buy_dc_period"):
            try:
                dc_p = int(self._get_param(getattr(self, "buy_dc_period"), 20))
            except Exception:
                dc_p = 20

        # 1) dc_high_prev (현재봉 제외, 이전 N개 기준)
        df["g_dc_high_prev"] = df["high"].shift(1).rolling(dc_p).max()

        # 2) close_pos = (close-low)/(high-low)
        rng = (df["high"] - df["low"]).replace(0, np.nan)
        df["g_close_pos"] = ((df["close"] - df["low"]) / rng).clip(0.0, 1.0).fillna(0.0)

        # 3) vol_ratio / vol_z (현재봉 제외한 통계로 계산: shift(1))
        lb = int(self.GUARD_VOL_LOOKBACK)
        v = df["volume"].astype(float)

        v_hist = v.shift(1)
        v_mean = v_hist.rolling(lb).mean()
        v_std = v_hist.rolling(lb).std(ddof=0)

        df["g_vol_ratio"] = (v / v_mean).replace([np.inf, -np.inf], np.nan)
        df["g_vol_z"] = ((v - v_mean) / v_std).replace([np.inf, -np.inf], np.nan)

        # 4) rsi14
        df["g_rsi14"] = ta.RSI(df, timeperiod=int(self.GUARD_RSI_PERIOD))

        return df

    def populate_entry_trend(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:
        df = super().populate_entry_trend(dataframe, metadata)

        if "enter_long" not in df.columns:
            return df

        entry = df["enter_long"].fillna(0).astype(int) == 1
        if entry.sum() == 0:
            return df

        # --- Guard 파라미터: override(config.strategy_parameters)에서 직접 읽음 ---
        close_pos_min = self._get_guard("guard_close_pos_min", None)
        close_confirm = int(self._get_guard("guard_close_confirm", 0) or 0)

        use_vol = int(self._get_guard("guard_use_vol", 0) or 0)
        vol_ratio_min = self._get_guard("guard_vol_ratio_min", None)
        vol_z_min = self._get_guard("guard_vol_z_min", None)

        use_rsi = int(self._get_guard("guard_use_rsi", 0) or 0)
        rsi_min = self._get_guard("guard_rsi14_min", None)

        guard = pd.Series(True, index=df.index)

        # (A) close_pos 가드
        if close_pos_min is not None:
            guard &= (df["g_close_pos"] >= float(close_pos_min))

        # (B) close-confirm (종가가 dc_high_prev 위)
        if close_confirm == 1:
            guard &= (df["close"] > df["g_dc_high_prev"])

        # (C) 거래량 가드
        if use_vol == 1:
            if vol_ratio_min is not None:
                guard &= (df["g_vol_ratio"] >= float(vol_ratio_min))
            if vol_z_min is not None:
                guard &= (df["g_vol_z"] >= float(vol_z_min))

        # (D) RSI 가드
        if use_rsi == 1 and rsi_min is not None:
            guard &= (df["g_rsi14"] >= float(rsi_min))

        blocked = entry & (~guard.fillna(False))
        if blocked.any():
            df.loc[blocked, "enter_long"] = 0
            if "enter_tag" in df.columns:
                df.loc[blocked, "enter_tag"] = "blocked_guardv4"

        return df
